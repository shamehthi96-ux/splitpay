# Copy to .env and fill in. Never commit .env.

# AI for receipt reading + "who had what" in plain English. Without a key the app runs in demo mode.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional alternative (used only if GEMINI_API_KEY is empty):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal SANDBOX app credentials from https://developer.paypal.com (Apps & Credentials -> Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PORT=8000
